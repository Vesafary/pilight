# pilightd configuration. Copy to /etc/pilight/pilightd.env and edit.
#
# systemd reads this file literally: no shell quoting, no variable expansion.
# Write  KEY=value  with no surrounding quotes unless the quotes are part of the
# value itself.

# ---------------------------------------------------------------- required ---

# The only setting with no default. The *database* must already exist; pilightd
# creates the tables itself on first start.
DATABASE_URL=postgres://pilight:CHANGEME@localhost/pilight

# ------------------------------------------------------------------ radio ---

# `nrf24` for real hardware, `none` to record commands without transmitting.
# `none` is useful for testing the Home Assistant side before the radio works.
PILIGHT_RADIO=nrf24

# How many times each command is repeated. The bulbs never acknowledge anything,
# so this is the only reliability there is. Lower it if commands feel sluggish;
# raise it if they get missed.
#PILIGHT_RADIO_REPEATS=50

# Pause between two *different* commands, in milliseconds. Not the same as the
# gap between repeats of one command. Sending "set colour temperature" the
# instant the "switch on" burst finishes leaves the bulb acting on the first and
# silently ignoring the second, so a request like "on, warm, 40%" appears to do
# nothing at all. 300 ms is enough on FUT092; 0 is definitely not. Only lower it
# if you have measured your own bulbs. See docs/protocol.md section 2.5.
#PILIGHT_COMMAND_GAP_MS=300

# ------------------------------------------------------------------- mqtt ---

# Your broker. With Home Assistant this is usually its Mosquitto add-on, on the
# Home Assistant host itself.
#
# Prefer an IP over a hostname: a musl-static build has no NSS and cannot
# resolve `.local` (mDNS) names. If you want to use one anyway, add an
# /etc/hosts entry on the Pi, or build against glibc instead.
PILIGHT_MQTT_HOST=192.0.2.10
PILIGHT_MQTT_PORT=1883

# Required if the broker sets `allow_anonymous false`, which HA's Mosquitto
# add-on does. Give pilight its own account rather than reusing a shared one:
# the broker's connection log is often how a network's MQTT devices get
# enumerated, and a shared account makes pilight indistinguishable from
# everything else using it.
#PILIGHT_MQTT_USERNAME=pilight
#PILIGHT_MQTT_PASSWORD=CHANGEME

# Must be unique on the broker; two clients sharing an id disconnect each other.
# Change it if something else already connects as `pilight`.
#PILIGHT_MQTT_CLIENT_ID=pilight

# Topic prefixes. Leave these alone unless they collide with something.
#PILIGHT_MQTT_PREFIX=pilight
#PILIGHT_MQTT_DISCOVERY_PREFIX=homeassistant

# --------------------------------------------------------------------- api ---

# Defaults to 0.0.0.0:8080 — reachable from anywhere on your network. Either
# bind it to localhost, or set a token below. Preferably both.
PILIGHT_API_ADDR=0.0.0.0:8080

# Bearer token for /api/v1. Unset means NO AUTHENTICATION, and pilightd says so
# in a warning at startup. Generate one with:  openssl rand -hex 32
#PILIGHT_API_TOKEN=CHANGEME

# ------------------------------------------------------------------ bulbs ---

# The Kelvin range your bulbs actually cover, used to map Home Assistant's
# temperature slider onto the protocol's 0-100 scale. MiLight does not publish
# this; 2700-6500 is what these bulbs are sold as.
#PILIGHT_MIN_KELVIN=2700
#PILIGHT_MAX_KELVIN=6500

# ---------------------------------------------------------------- logging ---

# info is a sensible default. Use pilightd=debug,pilight_mqtt=debug when
# something is not behaving.
RUST_LOG=info
